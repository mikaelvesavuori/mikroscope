{
  "$schema": "https://biomejs.dev/schemas/2.4.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git"
  },
  "files": {
    "includes": [
      "api/**/*",
      "app/**/*",
      "tests/**/*",
      "scripts/**/*",
      "*.json",
      "*.mjs",
      "*.ts",
      "!package-lock.json",
      "!dist",
      "!coverage",
      "!node_modules",
      "!app/fonts",
      "!.tmp"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "noForEach": "off"
      },
      "suspicious": {
        "noConsole": "off",
        "noExplicitAny": "error"
      }
    }
  }
}
